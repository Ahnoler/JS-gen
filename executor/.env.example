# Executor Agent 本地配置（可选，覆盖 config/.env）
# 复制为 executor/.env 后修改

# 业务层地址（会转为 ws://…/ws/executor）
CONTROL_PLANE_URL=http://127.0.0.1:4097

# 或直接指定 WS URL
# EXECUTOR_WS_URL=ws://127.0.0.1:4097/ws/executor

# 与业务层 config/.env 中 EXECUTOR_TOKEN 一致
EXECUTOR_TOKEN=change-me

# 稳定节点 ID（留空则首次启动写入 executor/.node-uuid）
# EXECUTOR_NODE_UUID=

EXECUTOR_NAME=dev-worker
EXECUTOR_CAPACITY=16
# Chrome CDP port base; slot i uses base+i (default 19242 — avoid leftover 9242 conflicts)
# EXECUTOR_CDP_PORT_BASE=19242
EXECUTOR_HEARTBEAT_INTERVAL_MS=20000
# heartbeat ack 超过该时长未收到 → 判定半开连接（NAT/LB 静默掐断），主动 terminate 强制重连（默认 40000 = 2×心跳间隔）
# EXECUTOR_HEARTBEAT_ACK_TIMEOUT_MS=40000

# Python 解释器（browser_use 环境）
# PYTHON_EXE=D:\anaconda3\envs\browser_use\python.exe

# Playwright 浏览器目录（可选）。不设则用 Playwright 默认缓存
# （Windows: %LOCALAPPDATA%\ms-playwright），新执行端只需:
#   npx playwright install chromium
# 需要固定到项目内 browser/ 时再显式设置，例如:
# PLAYWRIGHT_BROWSERS_PATH=D:\dev\JS-gen\browser

# Session Chrome headless（默认关）。true=无实体窗口，BiB 靠 CDP 推流（避免最小化节流）
# CHROME_HEADLESS=true
