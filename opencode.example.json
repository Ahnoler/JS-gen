{
	"$schema": "https://opencode.ai/config.json",
	"provider": {
		"myprovider": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "Ollama",
			"options": {
				"baseURL": "http://localhost:11434/v1",
				"apiKey": "YOUR_API_KEY_HERE"
			},
			"models": {
				"GLM-5": {
					"_launch": true,
					"name": "GLM-5"
				}
			}
		}
	},
	"agent": {
		"build": {
			"permission": {
				"skill": {
					"xbrowser": "allow",
					"clarification-protocol": "allow",
					"playwright-skill": "allow",
					"cdp-agent": "allow"
				}
			}
		}
	}
}
