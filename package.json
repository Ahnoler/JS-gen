{
  "name": "opencode-agent-api",
  "version": "1.0.0",
  "description": "Browser automation control plane: v2 trajectory record/replay, MySQL, executor, Playwright assemble/run",
  "type": "module",
  "imports": {
    "#config/*": "./config/*",
    "#src/*": "./src/*"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "executor": "node executor/agent.mjs",
    "executor:dev": "node --watch executor/agent.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "knex": "^3.3.0",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "mysql2": "^3.22.6",
    "playwright": "1.58.0",
    "pngjs": "^7.0.0",
    "undici": "^8.3.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "eslint": "^10.9.1",
    "eslint-plugin-jsdoc": "^64.2.1"
  }
}
