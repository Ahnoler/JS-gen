# ───────────────────────────────────────
# 智能填表系统 — 运行配置
# ───────────────────────────────────────

# 服务器
PORT=4097
HOST=0.0.0.0

# LLM 连接
LLM_BASE_URL=http://218.77.58.156:3000/v1
LLM_API_KEY=
# 默认模型（唯一真源；含 provider 前缀的名称需整名传给网关，代码不剥前缀）
LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# LLM 请求超时（毫秒，默认 120000）：上游挂起时快速失败
# LLM_TIMEOUT_MS=120000

# 表单填写 LLM（可选用更便宜的模型；缺省回落 LLM_MODEL）
FORM_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
FORM_LLM_BASE_URL=http://218.77.58.156:3000/v1
FORM_LLM_API_KEY=
# 表单 LLM 请求超时（毫秒，缺省回落 LLM_TIMEOUT_MS）
# FORM_LLM_TIMEOUT_MS=120000

# ── 角色级 LLM 配置（按角色独立配置模型/端点/密钥/超时；未设置则回落主 LLM_*）──
# 主 Agent（session_runner）始终用 LLM_MODEL/LLM_BASE_URL/LLM_API_KEY/LLM_TIMEOUT_MS。
# 以下键仅覆盖对应角色；留空 = 沿用主 LLM，不产生独立 LLM 实例。

# Phase Reviewer（阶段合约审查；未设置 MODEL/BASE_URL/API_KEY 三者时复用主 LLM）
# REVIEWER_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# REVIEWER_LLM_BASE_URL=http://218.77.58.156:3000/v1
# REVIEWER_LLM_API_KEY=
# Reviewer LLM 请求超时（毫秒）；未设置时跟随 AI_PHASE_REVIEWER_TIMEOUT_S（评审外层上限，默认 20s），再回落 LLM_TIMEOUT_MS
# REVIEWER_LLM_TIMEOUT_MS=20000

# Scenario Describer（跨阶段业务场景摘要；未设置 MODEL/BASE_URL/API_KEY 三者时复用主 LLM）
# SCENARIO_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
# SCENARIO_LLM_BASE_URL=http://218.77.58.156:3000/v1
# SCENARIO_LLM_API_KEY=
# Scenario LLM 请求超时（毫秒；缺省回落 LLM_TIMEOUT_MS）
# SCENARIO_LLM_TIMEOUT_MS=120000

# L1C 低置信区域分类（可选；模型缺省沿用主 LLM_MODEL，超时已有 L1C_LLM_TIMEOUT_MS）
# L1C_LLM_MODEL=Qwen/Qwen3.5-35B-A3B

# 批量动作预算：单步最多连续动作数（browser_use max_actions_per_step）
# 全局默认；0/空 = 不覆盖，走框架默认 10；Python 端最终 clamp 到 [1,10]
MAX_ACTIONS_PER_STEP=4

# MinIO 图片存储（截图上传/读取/删除）
# V3 批量推送 payload.screenshots[].bucket 取自 MINIO_BUCKET（截图实际所在桶），
# .file 取自 screenshot.storage_path；消费方用 bucket+file 经自己的 MinIO SDK 生成临时 URL。
MINIO_HOST=http://172.19.87.169:9001
MINIO_ENDPOINT=172.19.87.169
MINIO_PORT=9001
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=tansun@123
MINIO_BUCKET=uara-step-phase-picture
# 可选：MinIO 公网访问基础地址；留空时自动生成 MinIO 预签名 URL（默认 7 天）
MINIO_PUBLIC_URL=http://172.19.87.169:9001

# 截图上传失败本地暂存与自动补传
# 本地暂存目录（默认 {PROJECT_DIR}/tmp/pending-screenshots）
# SCREENSHOT_PENDING_DIR=
# 重试扫描间隔（毫秒），默认 180000（3 分钟）
# SCREENSHOT_RETRY_INTERVAL_MS=180000
# 最大重试次数，默认 3
# SCREENSHOT_MAX_RETRY=3
# 本地暂存文件保留时间（毫秒），默认 7 天
# SCREENSHOT_PENDING_TTL_MS=604800000

# Python 解释器路径（留空则自动查找系统 PATH 中的 python）
# PYTHON_EXE=C:\python\python.exe

# 项目根目录（留空则自动检测）
# PROJECT_DIR=

# Agent stderr 落盘目录（默认 {PROJECT_DIR}/logs/agent-stderr）
# AGENT_STDERR_LOG_DIR=

# MySQL（knex / DAO）— 默认指向服务器数据库（数据已迁移）
DB_HOST=47.101.58.49
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=js_gen

# 执行机 Agent（WS /ws/executor）— 未配置则拒绝所有执行机连接
EXECUTOR_TOKEN=devtoken123
# EXECUTOR_HEARTBEAT_TIMEOUT_MS=45000
# EXECUTOR_DISCONNECT_GRACE_MS=45000
# remote_session streamDetach ownership grace (ms); default 15min
# REMOTE_SESSION_GRACE_MS=900000
# 执行机 WS 断线超过该时长未恢复 → 杀全部 Python 会话（防录制事件静默丢失；默认 30000）
# EXECUTOR_DISCONNECT_TIMEOUT_MS=30000

# 执行机 Agent 进程（npm run executor）— 见 executor/.env.example
# CONTROL_PLANE_URL=http://127.0.0.1:4097
USE_EXECUTOR=true  # 浏览器 Session 下发到在线执行机 Agent（Phase A）

# Session Chrome 无头模式（默认关）。开=不弹实体窗口，BiB 仍通过 CDP screencast 推流；
# 可避免最小化/失焦导致的 ~2s 帧率节流。Linux 服务器开此开关后 start-all.sh 可不启 Xvfb。
CHROME_HEADLESS=true

# L1c: low-confidence region classify via LLM (default off)
# L1C_LLM=false
# L1C_LLM_TIMEOUT_MS=8000

# ── 灰度 / 行为开关（bool：false|0|off|no 为关；未设置用默认）──
# Python 统一入口：scripts/feature_flags.py
# Node 镜像（需控制面感知的）：config/config.js

# 相对 xpath 主定位（默认开启）。关：primary 回退 xpath_full；xpath_smart 仍进 candidates；回放不优先 smart
# RELATIVE_XPATH_PRIMARY=true

# 灰度：填写仅允许 xpath_smart（默认关）。关=无 xpath 时仍可用 label DOM 兜底（测试人员）；开=必须 xpath_smart
# XPATH_SMART_FILL_ONLY=false

# 跨阶段【业务场景】前文组装（默认开启）
# AI_PHASE_PREAMBLE=true

# Phase Reviewer（阶段合约 LLM 审查，默认开）。关=回退纯规则模式（apply_phase_intent）
# AI_PHASE_REVIEWER=true
# Reviewer LLM 超时（秒，默认 20）。与 REVIEWER_LLM_TIMEOUT_MS 配合（后者优先，单位毫秒）
# AI_PHASE_REVIEWER_TIMEOUT_S=20

# Scenario Describer（跨阶段业务场景摘要注入，默认开）。关=不注入 [业务场景摘要] HumanMessage
# AI_SCENARIO_DESCRIBER=true
# Scenario Describer 运行间隔（每 N 个 agent micro-step 运行一次，默认 3）
# SCENARIO_DESCRIBER_INTERVAL=3

# 关键动作写入 browser-use 长期 memory（默认开启）
# AI_MEMORY_WHITELIST=true

# 重复失败动作纠偏（默认关）：连续 2 步同动作同参数且结果均 err- 时，注入 [纠偏] 处方 HumanMessage（每阶段每签名一次）
# AI_DUP_FAILURE_CUE=false

# 点击导航识别（默认开）：index 点击后若 URL 跳转，注入 [导航] cue 提示已进入目标页、勿再找同一按钮
# AI_CLICK_NAV_CUE=true


# ── AI 记忆系统（P0）──
# 记忆事件旁路摄取（默认开，只写不读）
# AI_MEMORY_EVENTS=true
# 事实包注入（P1，默认关）
# AI_MEMORY_FACT_PACK=false
# 同 function 历史成功交易事实复用（P2-2，默认关；需配合 retrieve 传 functionId）
# AI_MEMORY_HISTORY=false
# LLM 决策记录（默认开）
# AI_MEMORY_DECISIONS=true
# 审计严格模式（默认关；开=策略校验不通过直接拦截）
# AI_MEMORY_AUDIT_STRICT=false
# 表单批量 LLM 生成期间发 form_batch_started/done 占位事件（默认开）：
# 长阶段 WS 空闲易被 NAT/LB 回收成半开连接而静默丢事件，占位事件保持事件流活跃
# AI_FORM_BATCH_HEARTBEAT=true
# Python 侧上报地址（本地默认 http://127.0.0.1:4097）
# MEMORY_CONTROL_URL=http://127.0.0.1:4097

# ── Partner 自动化平台（批量推送）──
# API 前缀（项目/系统/importDemand 共用）
# 当前默认指向同事本地联调服务 172.20.101.162:11001（原 test.atp 已停用；80 端口无服务）
PARTNER_API_BASE=http://172.20.101.162:11001/api
# 可选分别覆盖：
# PARTNER_SYSTEM_BASE_URL=http://172.20.101.162:11001/api
# PARTNER_IMPORT_DEMAND_URL=http://172.20.101.162:11001/api/demand/demandtranscation/importDemand
# 可选服务级兜底 token（仅供无登录态的脚本/联调；正常调用走请求头 access_token 透传；未配置且无请求 token 时回落代码内置的联调 JWT）

# ── SSO / 账号中心（产品登录 + 用户隔离）──
# 公司分配的应用 key（固定）
# SSO_APP_KEY=1920710182837141505
# 账号中心基址
# SSO_BASE_URL=http://test.paas.tansun.com.cn
# 仅 /api/v2/* 强制鉴权（默认关：关时全可见，向后兼容；开时无 token 或 token 无效返回 401）
# SSO_AUTH_REQUIRED=false
# 可选：直接配置账号中心 JWT 验签密钥（query_jwt_secret 返回的字符串）；未配置时自动调接口获取并缓存 1h
# SSO_JWT_SECRET=

# ── AI 录制步数 ──
# 单阶段 AI 录制最大步数上限（长表单如 120 字段需要 >30；短阶段由 reviewer 估算下压，不受影响）
# PHASE_MAX_STEPS=300
