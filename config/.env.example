# ───────────────────────────────────────
# 智能填表系统 — 运行配置
# ───────────────────────────────────────

# 服务器
PORT=4097
HOST=0.0.0.0

# LLM 连接
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=

# 表单填写 LLM（可选用更便宜的模型）
FORM_LLM_MODEL=deepseek-v4-flash
FORM_LLM_BASE_URL=https://api.deepseek.com
FORM_LLM_API_KEY=

# 批量推送 V3 截图存储桶
PUSH_V3_SCREENSHOT_BUCKET=uara
# 截图 URL 有效期（秒），默认 3600
PUSH_V3_SCREENSHOT_EXPIRES=3600

# MinIO 图片存储（截图上传/读取/删除）
# MINIO_HOST=http://your-minio-host:9001
# MINIO_ENDPOINT=your-minio-host
# MINIO_PORT=9001
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=your-minio-access-key
# MINIO_SECRET_KEY=your-minio-secret-key
# MINIO_BUCKET=js-gen
# 可选：MinIO 公网访问基础地址；留空时自动生成 MinIO 预签名 URL（默认 7 天）
# MINIO_PUBLIC_URL=http://your-minio-host:9001

# 截图上传失败本地暂存与自动补传
# 本地暂存目录（默认 {PROJECT_DIR}/tmp/pending-screenshots）
# SCREENSHOT_PENDING_DIR=
# 重试扫描间隔（毫秒），默认 180000（3 分钟）
# SCREENSHOT_RETRY_INTERVAL_MS=180000
# 最大重试次数，默认 3
# SCREENSHOT_MAX_RETRY=3
# 本地暂存文件保留时间（毫秒），默认 7 天
# SCREENSHOT_PENDING_TTL_MS=604800000

# Python 解释器路径（留空则自动查找系统 PATH 中的 python）
# PYTHON_EXE=C:\python\python.exe

# 项目根目录（留空则自动检测）
# PROJECT_DIR=

# Agent stderr 落盘目录（默认 {PROJECT_DIR}/logs/agent-stderr）
# AGENT_STDERR_LOG_DIR=

# MySQL（knex / DAO）
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=root
# DB_PASS=
# DB_NAME=js_gen

# 执行机 Agent（WS /ws/executor）— 未配置则拒绝所有执行机连接
# EXECUTOR_TOKEN=change-me
# EXECUTOR_HEARTBEAT_TIMEOUT_MS=45000
# EXECUTOR_DISCONNECT_GRACE_MS=45000
# remote_session streamDetach ownership grace (ms); default 15min
# REMOTE_SESSION_GRACE_MS=900000
# 执行机 WS 断线超过该时长未恢复 → 杀全部 Python 会话（防录制事件静默丢失；默认 30000）
# EXECUTOR_DISCONNECT_TIMEOUT_MS=30000

# 执行机 Agent 进程（npm run executor）— 见 executor/.env.example
# CONTROL_PLANE_URL=http://127.0.0.1:4097
# USE_EXECUTOR=true  # 浏览器 Session 下发到在线执行机 Agent（Phase A）

# Session Chrome 无头模式（默认关）。开=不弹实体窗口，BiB 仍通过 CDP screencast 推流；
# 可避免最小化/失焦导致的 ~2s 帧率节流。Linux 服务器开此开关后 start-all.sh 可不启 Xvfb。
# CHROME_HEADLESS=false

# L1c: low-confidence region classify via LLM (default off)
# L1C_LLM=false
# L1C_LLM_TIMEOUT_MS=8000

# ── 灰度 / 行为开关（bool：false|0|off|no 为关；未设置用默认）──
# Python 统一入口：scripts/feature_flags.py
# Node 镜像（需控制面感知的）：config/config.js

# 相对 xpath 主定位（默认开启）。关：primary 回退 xpath_full；xpath_smart 仍进 candidates；回放不优先 smart
# RELATIVE_XPATH_PRIMARY=true

# 灰度：填写仅允许 xpath_smart（默认关）。关=无 xpath 时仍可用 label DOM 兜底（测试人员）；开=必须 xpath_smart
# XPATH_SMART_FILL_ONLY=false

# 跨阶段【业务场景】前文组装（默认开启）
# AI_PHASE_PREAMBLE=true

# 关键动作写入 browser-use 长期 memory（默认开启）
# AI_MEMORY_WHITELIST=true

# 重复失败动作纠偏（默认关）：连续 2 步同动作同参数且结果均 err- 时，注入 [纠偏] 处方 HumanMessage（每阶段每签名一次）
# AI_DUP_FAILURE_CUE=false

# 点击导航识别（默认开）：index 点击后若 URL 跳转，注入 [导航] cue 提示已进入目标页、勿再找同一按钮
# AI_CLICK_NAV_CUE=true


# ── AI 记忆系统（P0）──
# 记忆事件旁路摄取（默认开，只写不读）
# AI_MEMORY_EVENTS=true
# 事实包注入（P1，默认关）
# AI_MEMORY_FACT_PACK=false
# 同 function 历史成功交易事实复用（P2-2，默认关；需配合 retrieve 传 functionId）
# AI_MEMORY_HISTORY=false
# LLM 决策记录（默认开）
# AI_MEMORY_DECISIONS=true
# 审计严格模式（默认关；开=策略校验不通过直接拦截）
# AI_MEMORY_AUDIT_STRICT=false
# 表单批量 LLM 生成期间发 form_batch_started/done 占位事件（默认开）：
# 长阶段 WS 空闲易被 NAT/LB 回收成半开连接而静默丢事件，占位事件保持事件流活跃
# AI_FORM_BATCH_HEARTBEAT=true
# Python 侧上报地址（本地默认 http://127.0.0.1:4097）
# MEMORY_CONTROL_URL=http://127.0.0.1:4097

# ── Partner 自动化平台（批量推送）──
# API 前缀（项目/系统/importDemand 共用）
# PARTNER_API_BASE=http://test.atp.tansun.com.cn/api
# 可选分别覆盖：
# PARTNER_SYSTEM_BASE_URL=http://test.atp.tansun.com.cn/api
# PARTNER_IMPORT_DEMAND_URL=http://test.atp.tansun.com.cn/api/demand/demandtranscation/importDemand
# 可选兜底 token（项目/系统/推送共用；未配置时用代码内联调默认 JWT）
# PARTNER_ACCESS_TOKEN=

# ── SSO / 账号中心（产品登录 + 用户隔离）──
# 公司分配的应用 key（固定）
# SSO_APP_KEY=1920710182837141505
# 账号中心基址
# SSO_BASE_URL=http://test.paas.tansun.com.cn
# 仅 /api/v2/* 强制鉴权（默认关：关时全可见，向后兼容；开时无 token 或 token 无效返回 401）
# SSO_AUTH_REQUIRED=false

# ── AI 录制步数 ──
# 单阶段 AI 录制最大步数上限（长表单如 120 字段需要 >30；短阶段由 reviewer 估算下压，不受影响）
# PHASE_MAX_STEPS=300
